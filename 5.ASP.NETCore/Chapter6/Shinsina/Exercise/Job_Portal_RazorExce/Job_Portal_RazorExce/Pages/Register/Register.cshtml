@page
@model Job_Portal_RazorExce.Pages.Jobs.RegisterModel
@{
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="color:red">
        @TempData["ErrorMessage"]
    </div>
}

<h2>Register</h2>

<form method="post">
    <input asp-for="User.Username" placeholder="Username" />
    <span asp-validation-for="User.Username" class="text-danger"></span>
    <br /><br />

    <input asp-for="User.Email" placeholder="Email" />
    <span asp-validation-for="User.Email" class="text-danger"></span>
    <br /><br />

    <input asp-for="User.Password" placeholder="Password" type="password" />
    <span asp-validation-for="User.Password" class="text-danger"></span>
    <br /><br />

    <button type="submit" class="btn btn-primary">Register</button>
    <div>
        <a asp-page="/Login/Login">Already Have Account? Login</a>
    </div>
</form>