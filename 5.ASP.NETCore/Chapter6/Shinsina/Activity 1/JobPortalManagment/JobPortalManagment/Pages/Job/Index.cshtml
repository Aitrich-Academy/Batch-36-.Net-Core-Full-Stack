@page
@model JobPortalManagment.Pages.Job.IndexModel
@{
}
<h1>JOB LIST</h1>
<div class="d-flex justify-content-end mb-3">
    <a asp-page="Create" class="btn btn-primary">Create New Job</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Job ID</th>
            <th>Job Title</th>
            <th>Company</th>
            <th>Location</th>
            @* <th>Employment Type</th> *@
            <th>Salary Range</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model.ListJobs)
        {
            <tr>
                <td>@job.ID</td>
                <td>@job.Title</td>
                <td>@job.Company</td>
                <td>@job.Location</td>
                @* <td>@job.EmploymentType</td> *@
                <td>@job.Salary</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@job.ID" class="btn btn-primary ">Edit</a>
                    <a asp-page="Details" asp-route-id="@job.ID" class="btn btn-primary">View</a>
                    <a asp-page="Delete" asp-route-id="@job.ID" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>