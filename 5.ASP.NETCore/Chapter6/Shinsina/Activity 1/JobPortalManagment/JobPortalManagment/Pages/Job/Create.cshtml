@page
@model JobPortalManagment.Pages.Job.CreateModel
@{
}
<h2>Create Job Post</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="JobPost.Title" class="control-label"></label>
        <input asp-for="JobPost.Title" class="form-control" />
        <span asp-validation-for="JobPost.Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="JobPost.Company" class="control-label"></label>
        <input asp-for="JobPost.Company" class="form-control" />
        <span asp-validation-for="JobPost.Company" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="JobPost.Location" class="control-label"></label>
        <input asp-for="JobPost.Location" class="form-control" />
        <span asp-validation-for="JobPost.Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="JobPost.EnvironmentType" class="control-label"></label>
        <select asp-for="JobPost.EnvironmentType" class="form-control">
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Contract">Contract</option>
        </select>
        <span asp-validation-for="JobPost.EnvironmentType" class="text-danger"></span>
    </div> 

    <div class="form-group">
        
        <label asp-for="JobPost.Salary" class="control-label"></label>
        <input asp-for="JobPost.Salary" class="form-control" />
        <span asp-validation-for="JobPost.Salary" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="JobPost.Description" class="control-label"></label>
        <textarea asp-for="JobPost.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="JobPost.Description" class="text-danger"></span>
    </div>

     <div class="form-group">
        <label asp-for="JobPost.Requirements" class="control-label"></label>
        <textarea asp-for="JobPost.Requirements" class="form-control" rows="3"></textarea>
        <span asp-validation-for="JobPost.Requirements" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobPost.PostedDate" class="control-label"></label>
        <input asp-for="JobPost.PostedDate" type="date" class="form-control" />
        <span asp-validation-for="JobPost.PostedDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobPost.ExpirationDate" class="control-label"></label>
        <input asp-for="JobPost.ExpirationDate" type="date" class="form-control" />
        <span asp-validation-for="JobPost.ExpirationDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}