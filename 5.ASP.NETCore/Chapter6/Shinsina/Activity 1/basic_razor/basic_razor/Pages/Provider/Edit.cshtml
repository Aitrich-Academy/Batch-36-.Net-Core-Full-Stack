@page
@model basic_razor.Pages.Provider.EditModel
@{
}
<h2>Edit Details of Employee</h2>
<form method="post"> 
    <p><b>Id:</b> @Model.Employees.Id</p>
    <input type="hidden" asp-for="Employees.Id" />

    <div class="mb-3">
        <label>New-Name</label>
        <input asp-for="Employees.Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>New Salary</label>
        <input asp-for="Employees.Salary" class="form-control" />
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-success">
            Update
        </button>

        <a asp-page="/Provider/Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>
