@page
@model UserApplication.Pages.CompanyMember.DeleteModel
@{
}
<h2>Delete Company Member</h2>

<h3>Are you sure you want to delete this?</h3>

<div>
    <p><b>Name:</b> @Model.Member.MemberName</p>
    <p><b>Email:</b> @Model.Member.Email</p>
    <p><b>Designation:</b> @Model.Member.Designation</p>
</div>

<form method="post">
    <button type="submit">Yes, Delete</button>
    <a asp-page="Index">Cancel</a>
</form>