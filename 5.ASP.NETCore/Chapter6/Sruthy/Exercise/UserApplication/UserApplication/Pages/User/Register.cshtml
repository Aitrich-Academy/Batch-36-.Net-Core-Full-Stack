@page
@model UserApplication.Pages.User.RegisterModel
@{
}
<h2>User Registration</h2>

<form method="post">

    <div>
        <label>User Name</label>
        <input asp-for="User.UserName" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="User.Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="User.Password" type="password" />
    </div>

    <button type="submit">Register</button>

</form>

<a asp-page="Login">Already have account? Login</a>
