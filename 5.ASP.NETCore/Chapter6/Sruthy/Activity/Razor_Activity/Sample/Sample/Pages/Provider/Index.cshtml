@page
@model Sample.Pages.Provider.IndexModel
@{
    //c#
}
<h1>Employee Page!!!!!</h1>
<a asp-page="Create"> Add New Employee</a>
<table border="1" class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Salary</th>
    </tr>

@foreach (var item in Model.Employee)
{
    //c#
    <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.Salary</td>
        <td><a asp-page="Edit" asp-route-id="@item.Id">Edit</a></td>
        <td><a asp-page="Details" asp-route-id="@item.Id">Details</a></td>
        <td><a asp-page="Delete" asp-route-id="@item.Id">Delete</a></td>
    </tr>

    
}
</table>

