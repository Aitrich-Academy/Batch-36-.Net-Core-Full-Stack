@page "{Id:int}"
@model Sample.Pages.Provider.DeleteModel
@{
}

<h2>Delete Employee</h2>

<h3>Are you sure you want to delete this?</h3>

<div>
    <p><strong>ID:</strong> @Model.Employee.Id</p>
    <p><strong>Name:</strong> @Model.Employee.Name</p>
    <p><strong>Salary:</strong> @Model.Employee.Salary</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Employee.Id" />
    <button type="submit" class="btn btn-success">Delete</button>
    <a asp-page="/Provider/Index" class="btn btn-outline-secondary">Cancel</a>
</form>