@page "/dashboard"
@using Login_Exercise_1_Blazor.Interface
@using Login_Exercise_1_Blazor.Model




@inject IJobService JobService
<style>
    .layout {
        display: flex;
        height: 100vh;
        font-family: Arial;
        background: #f4f6f9;
    }

    /* SIDEBAR */
    .sidebar {
        width: 220px;
        background: #1f6feb;
        color: white;
        padding: 20px;
    }

    .logo {
        margin-bottom: 30px;
    }

    .nav-item {
        display: block;
        padding: 10px;
        color: white;
        text-decoration: none;
        margin-bottom: 10px;
        border-radius: 6px;
    }

        .nav-item:hover {
            background: rgba(255,255,255,0.2);
        }

    /* MAIN */
    .main {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .sort {
        padding: 6px;
        border-radius: 5px;
    }

    /* JOBS */
    .job-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .job-card {
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0px 2px 6px rgba(0,0,0,0.1);
    }

    .job-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .view-btn {
        background: #1f6feb;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
    }

    .desc {
        color: gray;
        margin: 8px 0;
    }

    .tags span {
        background: #e8eefc;
        padding: 5px 10px;
        border-radius: 20px;
        margin-right: 5px;
        font-size: 12px;
    }

    /* RIGHT PANEL */
    .right-panel {
        width: 280px;
        background: white;
        padding: 10px;
    }

    .banner {
        height: 200px;
        background: linear-gradient(135deg, #6fb1fc, #4364f7);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .circle {
        width: 60px;
        height: 60px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }
</style>

<div class="layout">

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">
        <h2 class="logo">HireMe Now</h2>

        <NavLink class="nav-item" href="/dashboard">🏠 All Jobs</NavLink>
        <NavLink class="nav-item" href="/applications">📄 My Applications</NavLink>
        <NavLink class="nav-item" href="/messages">💬 Messages</NavLink>
        <NavLink class="nav-item" href="/profile">👤 My Profile</NavLink>
        <NavLink class="nav-item" href="/settings">⚙ Settings</NavLink>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main">

        <!-- TOP BAR -->
        <div class="topbar">
            <h3>Showing @jobs.Count Jobs</h3>

            <div>
                <label>Sort by:</label>
                <select class="sort">
                    <option>Newest Jobs</option>
                    <option>Oldest Jobs</option>
                </select>
            </div>
        </div>

        <!-- JOB LIST -->
        <div class="job-container">
            @foreach (var job in jobs)
            {
                <div class="job-card">
                    <div class="job-header">
                        <div>
                            <h4>@job.Title</h4>
                            <p>📍 @job.Location</p>
                        </div>
                        <button class="view-btn">View</button>
                    </div>

                    <p class="desc">@job.Description</p>

                    <div class="tags">
                        <span>@job.JobType</span>
                        <span>@job.Salary</span>
                        <span>@job.Location</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="banner">
            <div class="circle">
                🏢
            </div>
        </div>
    </div>

</div>

@code {
    List<Job> jobs = new();

    protected override async Task OnInitializedAsync()
    {
        jobs = await JobService.GetAllJobsAsync();
    }
}

