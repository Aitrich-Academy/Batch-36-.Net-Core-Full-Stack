@page "/register"
@using Login_Exercise_1_Blazor.DTO
@using Login_Exercise_1_Blazor.Interface

@inject ISeekerService SeekerService
@inject NavigationManager Navigation
<style>
    .registration-page{
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(to right, #e5e5e5 50%, #69aee8 50%);
    }
    .register-container{
        width: 870px;
        height: 450px;
        background: white;
        border-radius: 25px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }
    .left-panel {
        width: 50%;
    }

        .left-panel img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .right-panel {
        
        width: 50%;
        background: #f8f8f8;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 40px;
    }

    .register-form {
        padding-left:10px;
        padding-top:4px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 20px;
        row-gap: 12px;
        width: 420px;
    }

    .field {
        display: flex;
        flex-direction: column;
    }

        .field label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .field input {
            width: 180px;
            height: 26px;
            padding: 4px 8px;
            border: 1px solid #d9d9d9;
            font-size: 12px;
            outline: none;
        }

    .gender-section {
        width: 420px;
        margin-top: 10px;
        padding-left:10px;
    }

        .gender-section label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

    .gender-options {
        display: flex;
        gap: 10px;
        font-size: 12px;
       
    }

    .action-section {
        width: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

    .register-btn {
        width: 140px;
        height: 30px;
        border: 1px solid #4da3ff;
        background: white;
        color: #4da3ff;
        cursor: pointer;
    }

    .signin-link {
        margin-top: 12px;
        font-size: 12px;
        text-align: center;
    }

        .signin-link a {
            color: #4da3ff;
            text-decoration: none;
        }

    .error {
        color: red;
        font-size: 11px;
        min-height: 14px;
    }

    .form-error {
        color: red;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 10px;
    }
</style>
<div class="registration-page">
    <div class="register-container">
        <div class="left-panel">
            <img src="images/registeer.jpg" alt="registr Image" />
        </div>
            <div class="right-pannel">
            <h3 style="padding-top: 20px;padding-left:10px;"><strong>Registration</strong></h3>
            <div class="register-form">

                <div class="field">
                    <label>First Name</label>
                    <input @bind="model.FirstName" placeholder="Enter First Name" />
                    <span class="error">@firstNameError</span>
                </div>

                <div class="field">
                    <label>Last Name</label>
                    <input @bind="model.LastName" placeholder="Enter Last Name" />
                    <span class="error">@lastNameError</span>
                </div>

                <div class="field">
                    <label>Email</label>
                    <input @bind="model.Email" placeholder="Enter Email" />
                    <span class="error">@emailError</span>
                </div>

                <div class="field">
                    <label>Phone Number</label>
                    <input @bind="model.PhoneNumber" placeholder="Enter Phone Number" />
                    <span class="error">@phoneError</span>
                </div>

                <div class="field">
                    <label>Password</label>
                    <input type="password"
                           @bind="model.Password"
                           placeholder="Enter Password" />
                    <span class="error">@passwordError</span>
                </div>

                <div class="field">
                    <label>Confirm Password</label>
                    <input type="password"
                           @bind="model.ConfirmPassword"
                           placeholder="Confirm Password" />
                    <span class="error">@confirmPasswordError</span>
                </div>

</div>

            <div class="gender-section">

                <label>Gender</label>

                <InputRadioGroup @bind-Value="model.Gender">

                    <label style="display:inline-block;margin-right:15px;">
                        <InputRadio Value="@("Male")" />
                        Male
                    </label>

                    <label style="display:inline-block;margin-right:15px;">
                        <InputRadio Value="@("Female")" />
                        Female
                    </label>

                    <label style="display:inline-block;">
                        <InputRadio Value="@("Other")" />
                        Other
                    </label>

                </InputRadioGroup>

                <div class="error">@genderError</div>

            </div>
            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="form-error">@formError</div>
            }
            <div class="action-section">
                <button class="register-btn" @onclick="Registerr">Register</button>
                <div class="signin-link">
                    Already have an account?
                    <a href="/login">Sign in</a>
                </div>
                
            </div>
        </div>
    </div>
</div>




@code {
    string firstNameError = "";
string lastNameError = "";
string emailError = "";
string phoneError = "";
string passwordError = "";
string confirmPasswordError = "";
string genderError = "";
string formError = "";
    
    SeekerRegisterDTO model = new();

    private async Task Registerr()
    {
        firstNameError = "";
        lastNameError = "";
        emailError = "";
        phoneError = "";
        passwordError = "";
        confirmPasswordError = "";
        genderError = "";
        formError = "";

        bool isValid = true;

        if (string.IsNullOrWhiteSpace(model.FirstName))
        {
            firstNameError = "Required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.LastName))
        {
            lastNameError = "Required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            emailError = "Required";
            isValid = false;
        }

        if (model.PhoneNumber == null)
        {
            phoneError = "Required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.Password))
        {
            passwordError = "Required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.ConfirmPassword))
        {
            confirmPasswordError = "Required";
            isValid = false;
        }
        else if (model.Password != model.ConfirmPassword)
        {
            confirmPasswordError = "Passwords do not match";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.Gender))
        {
            genderError = "Select Gender";
            isValid = false;
        }

        if (!isValid)
        {
            formError = "Please fill the form";
            return;
        }

        await SeekerService.RegisterAsync(model);
        Navigation.NavigateTo("/login");
    }
}
