@model List<StudentPortal.Models.Student>

<div class="container">
    <div class="row">

        <div class="col-md-3">
            @Html.Partial("_Sidebar")
        </div>

        <div class="col-md-9">

            <h2>Student List</h2>

            <a asp-action="Add"
               asp-controller="Student"
               class="btn btn-primary mb-3">
                Add Student
            </a>

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>@student.Name</td>
                            <td>@student.Email</td>
                            <td>@student.Phone</td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@student.Id"
                                   class="btn btn-warning">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>