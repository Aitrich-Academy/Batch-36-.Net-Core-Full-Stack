@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HireMeNow</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
            body {
                background-color: #f5f7fb;
            }

            .navbar-brand {
                font-weight: bold;
            }

            footer {
                margin-top: 50px;
                padding: 15px;
                text-align: center;
                background: #ffffff;
                border-top: 1px solid #ddd;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">

            <a class="navbar-brand" href="/">
                HireMeNow
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                   

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="JobSeeker" asp-action="Profile">
                            Profile
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="JobSeeker" asp-action="AppliedJobs">
                            My Jobs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="JobSeeker" asp-action="AllJobs">
                            All Jobs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger"
                           asp-controller="Public"
                           asp-action="Logout">
                            Logout
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        <p>© 2026 HireMeNow. All rights reserved.</p>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>