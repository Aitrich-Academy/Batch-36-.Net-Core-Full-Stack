@model IEnumerable<JobApplication>

@{
    Layout = "_PubLayout";
    ViewData["Title"] = "Applied Jobs";
}

<div class="container mt-4">

    <div class="row">

        <!-- LEFT SIDEBAR -->
        <div class="col-md-3">
            @Html.Partial("_Sidebar")
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-md-9">

            <h2 class="mb-4">Applied Jobs</h2>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    You have not applied for any jobs yet.
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">

                            <h5 class="card-title">
                                @item.Job?.JobTitle
                            </h5>

                            <p class="card-text">
                                @item.Job?.Description
                            </p>

                            <p>
                                <strong>Applied Date:</strong>
                                @item.AppliedDate?.ToString("dd MMM yyyy")
                            </p>

                            <form asp-action="DeleteApplication"
                                  asp-controller="JobSeeker"
                                  method="post"
                                  class="mt-2">

                                <input type="hidden" name="id" value="@item.ApplicationId" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to remove this application?');">
                                    Delete Application
                                </button>

                            </form>

                        </div>
                    </div>
                }
            }

        </div>
    </div>

</div>