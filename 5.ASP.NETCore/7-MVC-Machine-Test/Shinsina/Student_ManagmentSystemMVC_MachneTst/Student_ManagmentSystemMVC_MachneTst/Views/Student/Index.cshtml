@model IEnumerable<Student_ManagmentSystemMVC_MachneTst.Models.Student>

@{
    ViewData["Title"] = "Student List";
}
<h2>Student List</h2>
<div>
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Student</a>
        <a asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
    </p>
    <table>

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Age</th>
            <th>Action</th>
        </tr>

        @foreach(var item in Model)
        {
            <tr>
               
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Course</td>
                <td>@item.Age</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"onclick="return confirm('delete student?')'">Delete</a>
                </td>
            </tr>
        }
    </table>
</div>