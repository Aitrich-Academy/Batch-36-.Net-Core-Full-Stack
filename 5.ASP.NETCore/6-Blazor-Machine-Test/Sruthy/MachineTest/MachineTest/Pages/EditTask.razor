@page "/edittask/{TaskId:int}"
@using Microsoft.EntityFrameworkCore
@using MachineTest.Model
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<h3>EditTask</h3>
@if (task == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="task" OnValidSubmit="UpdateTask">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Title</label>
            <InputText class="form-control" @bind-Value="task.Title" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <InputTextArea class="form-control"
                           @bind-Value="task.Description" />
        </div>
        <div class="mb-3">
            <label>Due Date</label>
            <InputDate class="form-control" @bind-Value="task.DueDate" />
        </div>

        <div class="mb-3">
            <label>Status</label>
            <InputSelect class="form-control" @bind-Value="task.Status">
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">
            Update
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Back">
            Cancel
        </button>
    </EditForm>
}

@code {

    [Parameter]
    public int TaskId { get; set; }

    private TaskItem? task;

    protected override async Task OnInitializedAsync()
    {
        task = await DbContext.Tasks.FindAsync(TaskId);
    }

    private async Task UpdateTask()
    {
        if (task != null)
        {
            DbContext.Tasks.Update(task);
            await DbContext.SaveChangesAsync();

            Navigation.NavigateTo("/tasks");
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/tasks");
    }
}


