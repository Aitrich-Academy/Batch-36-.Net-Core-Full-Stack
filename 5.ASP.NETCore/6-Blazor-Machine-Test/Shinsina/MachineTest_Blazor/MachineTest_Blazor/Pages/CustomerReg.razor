@page "/CustomerReg"

@using MachineTest_Blazor.Model
@using MachineTest_Blazor.Interface

@inject ICustomerService CustomerService
<h3>CustomerReg</h3>
@if(!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">
        @message
    </div>
}
@* @if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div>
        @ErrorMessage
    </div>
} *@
<EditForm Model="@customer" OnValidSubmit="SaveCustomer" >
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <div>
        <label>Full Name</label>
        <InputText class="form-control" @bind-value="customer.FullName" />
        <ValidationMessage For="@(()=>customer.FullName)"/>
    </div>
    <div>
        <label>Email Address</label>
        <InputText class="form-control" @bind-value="customer.EmailAddress" />
        <ValidationMessage For="@(() => customer.EmailAddress)" />
    </div>
    <div>
        <label>Rating</label>
        <InputSelect class="form-control" @bind-value="customer.Rating">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </InputSelect>
        <ValidationMessage For="@(() => customer.Rating)" />
    </div>
    <div>
        <label> Comments</label>
        <InputText class="form-control" @bind-value="customer.Comments" rows="5"/>
        <ValidationMessage For="@(() => customer.Comments)" />
    </div>
    <div class="mt-3">
        <button class="btn btn-success" type="submit">
            Submit
        </button>
    </div>
</EditForm>
<h2>Customer Feedback</h2>
<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Rating</th>
        <th>Comments</th>

    </tr>
    @foreach (var customer in customerList)
    {
        <tr>
            <td>@customer.FullName</td>
            <td>@customer.EmailAddress</td>
            <td>@customer.Rating</td>
            <td>@customer.Comments</td>
        </tr>
    }
</table>

@code {
    private Customer customer=new();
    private List<Customer> customerList = new();
    private string message=string.Empty;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        customerList = await CustomerService.GetAllCustomerAsync();
    }
    private async Task SaveCustomer()
    {
        await CustomerService.AddCustomersAsync(customer);
        message = "Submitted Successfully!!";
        // ErrorMessage = string.Empty;
        customer = new Customer();
        customerList = await CustomerService.GetAllCustomerAsync();
       
        

    }
}
