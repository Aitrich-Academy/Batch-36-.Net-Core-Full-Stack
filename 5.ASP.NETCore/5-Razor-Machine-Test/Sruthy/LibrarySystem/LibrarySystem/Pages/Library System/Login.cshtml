@page
@model LibrarySystem.Pages.Library_System.LoginModel
@{
}
<h2>Login</h2>
<form method="post">
    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>
    <br/>
    <div>
        <label>Password</label>
        <input asp-for="Password" type="password"/>
    </div>
    <br />
    <button type="submit" class="btn-success">Login</button>
</form>
<h3>@Model.Message</h3>