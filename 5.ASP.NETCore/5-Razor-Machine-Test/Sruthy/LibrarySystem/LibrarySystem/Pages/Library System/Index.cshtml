@page
@model LibrarySystem.Pages.Library_System.IndexModel
@{
}
<h2>Book List</h2>
<table class="table" border="1">
    <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Author</th>
        <th>Quantity</th>
        @if(HttpContext.Session.GetString("Role")=="Admin")
        {
            <th>Actions</th>
        }
    </tr>
    @foreach(var book in Model.Books)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Quantity</td>
            @if(HttpContext.Session.GetString("Role")=="Admin")
            {
                <td>
                    <a href="/Library System/EditBook?id=@book.Id">
                        <button>Edit</button>
                    </a>
                    <a href="/Library System/DeleteBook?id=@book.Id">
                        <button>Delete</button>
                    </a>
                </td>
            }
        </tr>
    }
</table>