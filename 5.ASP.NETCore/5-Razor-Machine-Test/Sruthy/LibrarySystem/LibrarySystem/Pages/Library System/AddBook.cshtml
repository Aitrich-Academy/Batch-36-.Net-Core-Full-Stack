@page
@model LibrarySystem.Pages.Library_System.AddBookModel
@{
}
<h2>Add New Book</h2>
<form method="post">
    <div>
        <label>Title</label>
        <input asp-for="Book.Title"/>
    </div>
    <br/>
    <div>
        <label>Author</label>
        <input asp-for="Book.Author" />
    </div>
    <br />
    <div>
        <label>Quantity</label>
        <input asp-for="Book.Quantity" />
    </div>
    <br />
    <button type="submit">Add Book</button>

</form>