@page
@model Library_Managment_MechineTest.Pages.User.RegisterModel
@{
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
<h2>Library Account Registration</h2>

<form method="post">
    <div class="mb-3">
        <input asp-for="regUser.UserName" placeholder="Enter your Username" />
    </div>
    
    <div class="mb-3">
        <input asp-for="regUser.Password" placeholder="Create Password " type="password" />
   </div>
    <div class="mb-3">
        <input asp-for="regUser.Role" placeholder="Enter your Role" />
    </div>
    <div class="mb-3">
        <a class="btn btn-success" href="/User/Login">Register</a>
</div>
    

</form>