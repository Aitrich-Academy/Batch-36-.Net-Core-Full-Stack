@page
@model Library_Managment_MechineTest.Pages.Book.AddBooksModel
@{
}
<h2>Add Book</h2>
<form method="post">
    <div class="mb-3">
        <label asp-for="Book.Title" class="form-label">Title:</label>
        <input asp-for="Book.Title" class="form-control" placeholder="Enter the Title of Book"/>
    </div>
    <div class="mb-3">
        <label asp-for="Book.Author" class="form-label">Author:</label>
        <input asp-for="Book.Author" class="form-control" placeholder="Enter the Author of Book" />
    </div>
    <div class="mb-3">
        <label asp-for="Book.Quantity" class="form-label">Title:</label>
        <input asp-for="Book.Quantity" class="form-control" placeholder="Enter the Quantty of Book" />
    </div>
    <div>
        <button type="submit" class="btn btn-success">
            Add
        </button>
        <a class="btn btn-primary" href="/Book/Books">Back</a>
    </div>

</form>