@page
@model Library_Managment_MechineTest.Pages.Book.EditModel
@{
}

<h2>Edit Book</h2>

<form method="post">

    <input type="hidden" asp-for="Book.ID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Book.Title" class="form-label"></label>

        <input asp-for="Book.Title"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Book.Author" class="form-label"></label>

        <input asp-for="Book.Author"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Book.Quantity" class="form-label"></label>

        <input asp-for="Book.Quantity"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Update
    </button>

    <a href="/Book/Index" class="btn btn-secondary">
        Back
    </a>

</form>
