@page
@model Library_Managment_MechineTest.Pages.Book.BooksModel
@{
}

<h2>List Of Books Available</h2>

@if (Model.Role == "Admin")
{
    <a class="btn btn-primary mb-3" href="/Book/AddBooks">
        Add Books
    </a>
}

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Author</th>
        <th>Quantity</th>

        @if (Model.Role == "Admin")
        {
            <th>Actions</th>
        }
    </tr>

    @foreach (var item in Model.Books)
    {
        <tr>
            <td>@item.ID</td>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Quantity</td>

            @if (Model.Role == "Admin")
            {
                <td>
                    <a class="btn btn-primary"
                       href="/Book/Edit?id=@item.ID" >
                        Update
                    </a>
                    

                    <a class="btn btn-primary"
                       href="/Book/Details?id=@item.ID">
                        Details
                    </a>
                    <a class="btn btn-danger"
                       href="/Book/Delete?id=@item.ID">
                        Delete
                    </a>
                </td>
            }
        </tr>
    }

</table>
<a class="btn btn-secondary"
        href="/User/Register">
Logout
</a>